# ---------------------------------------------------------------------------
# Headwaters backend configuration. Copy to .env for local development.
# Production values live in the Render environment group and are never in Git.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- database --------------------------------------------------------------
# TWO connections, and the distinction is a security control.
#
# DATABASE_URL      PRIVILEGED. Migrations, bootstrap, worker. Bypasses RLS by
#                   design: a worker is a system actor spanning every org.
# DATABASE_URL_APP  UNPRIVILEGED. Every read/write on behalf of a user. Must
#                   authenticate as a role that is neither SUPERUSER nor holds
#                   BYPASSRLS -- those two attributes defeat row-level security
#                   unconditionally (FORCE ROW LEVEL SECURITY does bind a plain
#                   table owner, but cannot bind either of those).
#
# The API verifies this at startup and REFUSES TO SERVE if the request-path
# connection can bypass RLS. There is no safe degraded mode: the failure is
# invisible at runtime and its symptom is cross-tenant disclosure.

DATABASE_URL=postgresql+psycopg://headwaters:headwaters@db:5432/headwaters
DATABASE_URL_APP=postgresql+psycopg://headwaters_app:local-dev-only@db:5432/headwaters

# Granted to headwaters_app by `python -m app.db.bootstrap`. The migration
# creates the role NOLOGIN; a credential never belongs in a migration file.
APP_DB_PASSWORD=local-dev-only

# Supabase: point DATABASE_URL at the Supavisor TRANSACTION pooler (port 6543)
# as the owner, and DATABASE_URL_APP at the same pooler as headwaters_app.
# Connecting the request path as `postgres` on Supabase disables every policy --
# `postgres` is a superuser there.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL_APP=postgresql+psycopg://headwaters_app:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- CORS ------------------------------------------------------------------
# Comma-separated. Never a wildcard: any extension on the user's machine could
# otherwise call this API with their credentials.
ALLOWED_ORIGINS=http://localhost:3000

# --- uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400          # 25 MiB, enforced before the body is buffered

# --- OpenAI (used from Phase 7; the app boots without these) ---------------
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACT=gpt-4o-mini
OPENAI_MODEL_NARRATIVE=gpt-4.1
PROMPT_VERSION=v1

# --- Supabase (used from Phase 2/9) ---------------------------------------
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- evidence signing (used from Phase 8) ---------------------------------
# base64-encoded Ed25519 private key. Generate with: make evidence-key
EVIDENCE_SIGNING_KEY=

# --- threat intel mode (used from Phase 6) --------------------------------
# cached = read only from the local fixture cache. The demo runs in this mode.
TI_MODE=cached

# --- observability ---------------------------------------------------------
SENTRY_DSN=
